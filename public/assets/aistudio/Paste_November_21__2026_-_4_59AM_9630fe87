        const firstGlobalIdx = allIds.indexOf(firstLessonId);
        const isUnitUnlocked = firstGlobalIdx === 0 || userState.completedLessons.includes(allIds[firstGlobalIdx - 1]) || userState.completedLessons.includes(firstLessonId);

        const unitDiv = document.createElement("div");
        unitDiv.className = "space-y-5";

        // Unit Header Card
        const header = document.createElement("div");
        header.className = `${isUnitUnlocked ? unit.color : "bg-gray-400"} text-white rounded-2xl p-4 shadow-sm border-b-4 ${isUnitUnlocked ? unit.borderColor : "border-gray-500"}`;
        header.innerHTML = `
          <div class="flex items-start justify-between gap-2">
            <div>
              <h3 class="font-extrabold text-base leading-snug">${unit.title}</h3>
              <p class="text-xs text-white/90 mt-0.5">${unit.subtitle}</p>
            </div>
            ${!isUnitUnlocked ? `
