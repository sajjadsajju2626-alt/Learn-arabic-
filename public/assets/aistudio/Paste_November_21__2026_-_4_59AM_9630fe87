          const btn = document.createElement("button");
          btn.disabled = !isUnlocked;
          let btnClasses = "btn-3d w-20 h-20 rounded-full flex items-center justify-center text-3xl font-bold border-b-8 shadow-md relative transition ";
          if (isCompleted) {
            btnClasses += "bg-[#FFC800] border-[#E5A400] text-white";
          } else if (isCurrent) {
            btnClasses += `${unit.color} ${unit.borderColor} text-white ring-4 ring-green-200`;
          } else {
            btnClasses += "bg-gray-200 border-gray-300 text-gray-400 cursor-not-allowed";
          }
          btn.className = btnClasses;
          btn.innerHTML = isCompleted ? "⭐" : (isUnlocked ? `<span class="font-arabic">${lesson.icon}</span>` : "🔒");

          if (isUnlocked) {
            btn.addEventListener("click", () => {
              playTone("tap");
              startLesson(lesson);
            });
          }

          const label = document.createElement("span");
          label.className = `mt-2 text-xs font-extrabold text-center max-w-[140px] ${isUnlocked ? "text-gray-700" : "text-gray-400"}`;
          label.textContent = lesson.title;

          nodeWrapper.appendChild(btn);
          nodeWrapper.appendChild(label);
          pathWrapper.appendChild(nodeWrapper);
        });

        unitDiv.appendChild(pathWrapper);
        container.appendChild(unitDiv);
      });

      // Attach Jump Here listeners
      document.querySelectorAll(".jump-unit-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          playTone("tap");
          const targetIdx = parseInt(btn.dataset.jumpUnit, 10);
          startUnitJumpTest(targetIdx);
        });
      });
    }

