            });
          }

          bank.innerHTML = "";
          shuffledWords.forEach((w, i) => {
            const isUsed = activeSession.wordBankSelected.some(item => item.id === i);
            const chip = document.createElement("button");
            chip.disabled = isUsed;
            chip.className = `btn-3d px-4 py-2.5 rounded-xl border-2 border-b-4 font-bold transition ${
              isUsed
                ? "bg-gray-200 border-gray-200 text-transparent cursor-default"
                : "bg-white border-gray-300 text-gray-800 hover:bg-gray-50"
            } ${q.isArabicWords ? "font-arabic text-2xl" : "text-sm"}`;
            chip.textContent = w;
            chip.addEventListener("click", () => {
              playTone("tap");
              if (q.isArabicWords) speakArabic(w, 0.9);
              activeSession.wordBankSelected.push({ id: i, text: w });
              refreshWordBank();
            });
            bank.appendChild(chip);
          });

          if (activeSession.wordBankSelected.length > 0) {
            enableCheckButton();
          } else {
            checkBtn.disabled = true;
            checkBtn.className = "btn-3d w-full py-3.5 rounded-2xl font-extrabold text-base uppercase tracking-wide bg-gray-200 text-gray-400 border-b-4 border-gray-300 cursor-not-allowed";
          }
        }

        bodyDiv.appendChild(tray);
        bodyDiv.appendChild(bank);
        refreshWordBank();
      }
      else if (q.type === "pairs") {
        // Hide bottom check button for instant pair matching
        document.getElementById("check-area").classList.add("hidden");

        const grid = document.createElement("div");
        grid.className = "grid grid-cols-2 gap-3";

        const leftCol = document.createElement("div");
        leftCol.className = "space-y-3";
        const rightCol = document.createElement("div");
        rightCol.className = "space-y-3";

        const leftItems = q.pairs.map((p, idx) => ({ idx, text: p.ar })).sort(() => 0.5 - Math.random());
        const rightItems = q.pairs.map((p, idx) => ({ idx, text: p.ml })).sort(() => 0.5 - Math.random());

        function handlePairCheck() {
          if (activeSession.selectedLeft && activeSession.selectedRight) {
            const l = activeSession.selectedLeft;
            const r = activeSession.selectedRight;
            if (l.idx === r.idx) {
              playTone("correct");
              l.el.className = "w-full p-4 rounded-2xl border-2 border-green-300 bg-green-100 text-green-700 font-arabic text-2xl font-bold opacity-60 cursor-default";
              r.el.className = "w-full p-4 rounded-2xl border-2 border-green-300 bg-green-100 text-green-700 text-sm font-extrabold opacity-60 cursor-default";
              l.el.disabled = true;
              r.el.disabled = true;
              activeSession.pairsMatched += 1;
              activeSession.selectedLeft = null;
              activeSession.selectedRight = null;

              if (activeSession.pairsMatched === q.pairs.length) {
                activeSession.score += 1;
                setTimeout(() => showFeedbackDrawer(true, "എല്ലാ ജോഡികളും കൃത്യമായി യോജിപ്പിച്ചു!"), 300);
              }
            } else {
              playTone("wrong");
              l.el.classList.add("border-red-500", "bg-red-50", "animate-shake");
              r.el.classList.add("border-red-500", "bg-red-50", "animate-shake");
              deductHeart();
              setTimeout(() => {
                l.el.classList.remove("border-red-500", "bg-red-50", "border-[#1CB0F6]", "bg-sky-50", "animate-shake");
                r.el.classList.remove("border-red-500", "bg-red-50", "border-[#1CB0F6]", "bg-sky-50", "animate-shake");
              }, 450);
              activeSession.selectedLeft = null;
              activeSession.selectedRight = null;
            }
          }
        }

        leftItems.forEach(item => {
          const btn = document.createElement("button");
          btn.className = "btn-3d w-full p-4 rounded-2xl border-2 border-b-4 border-gray-200 bg-white font-arabic text-2xl font-bold text-gray-800";
          btn.textContent = item.text;
          btn.addEventListener("click", () => {
            if (btn.disabled) return;
            playTone("tap");
            speakArabic(item.text, 0.85);
            leftCol.querySelectorAll("button:not(:disabled)").forEach(b => b.classList.remove("border-[#1CB0F6]", "bg-sky-50"));
            btn.classList.add("border-[#1CB0F6]", "bg-sky-50");
            activeSession.selectedLeft = { idx: item.idx, el: btn };
            handlePairCheck();
          });
          leftCol.appendChild(btn);
        });

        rightItems.forEach(item => {
          const btn = document.createElement("button");
          btn.className = "btn-3d w-full p-4 rounded-2xl border-2 border-b-4 border-gray-200 bg-white text-sm font-extrabold text-gray-800 min-h-[68px]";
          btn.textContent = item.text;
          btn.addEventListener("click", () => {
            if (btn.disabled) return;
            playTone("tap");
            rightCol.querySelectorAll("button:not(:disabled)").forEach(b => b.classList.remove("border-[#1CB0F6]", "bg-sky-50"));
            btn.classList.add("border-[#1CB0F6]", "bg-sky-50");
            activeSession.selectedRight = { idx: item.idx, el: btn };
            handlePairCheck();
          });
          rightCol.appendChild(btn);
        });

        grid.appendChild(leftCol);
        grid.appendChild(rightCol);
        bodyDiv.appendChild(grid);
      }

      container.appendChild(bodyDiv);
    }

    function enableCheckButton() {
      const checkBtn = document.getElementById("check-answer-btn");
      checkBtn.disabled = false;
      checkBtn.className = "btn-3d w-full py-3.5 rounded-2xl font-extrabold text-base uppercase tracking-wide bg-[#58CC02] text-white border-b-4 border-[#46A302] cursor-pointer";
    }

    function deductHeart() {
      activeSession.hearts = Math.max(0, activeSession.hearts - 1);
      if (activeSession.mode === "lesson") {
        userState.hearts = activeSession.hearts;
        saveState();
      }
      document.getElementById("lesson-hearts-count").textContent = activeSession.hearts;
      if (activeSession.hearts === 0) {
        setTimeout(() => {
          document.getElementById("out-of-hearts-modal").classList.remove("hidden");
        }, 400);
      }
    }

    document.getElementById("check-answer-btn").addEventListener("click", () => {
      if (activeSession.isAnswered) return;
      activeSession.isAnswered = true;

      const q = activeSession.questions[activeSession.currentIndex];
      let correct = false;
      let correctDisplay = "";

      if (q.type === "mcq" || q.type === "listen") {
        correct = activeSession.selectedAnswer === q.answer;
        correctDisplay = q.answer;
      } else if (q.type === "wordbank") {
        const userWords = activeSession.wordBankSelected.map(w => w.text);
        correct = JSON.stringify(userWords) === JSON.stringify(q.answer);
        correctDisplay = q.answer.join(" ");
      }

      if (correct) {
        activeSession.score += 1;
        playTone("correct");
        showFeedbackDrawer(true, "ശരിയായ ഉത്തരം!");
      } else {
        playTone("wrong");
        deductHeart();
        showFeedbackDrawer(false, `ശരിയായ ഉത്തരം: ${correctDisplay}`);
      }
    });

    function showFeedbackDrawer(isCorrect, detailText) {
      const drawer = document.getElementById("feedback-drawer");
      const icon = document.getElementById("feedback-icon");
      const title = document.getElementById("feedback-title");
      const detail = document.getElementById("feedback-detail");
      const contBtn = document.getElementById("continue-lesson-btn");

      drawer.classList.remove("hidden", "bg-green-100", "text-green-800", "bg-red-100", "text-red-800");
      if (isCorrect) {
        drawer.classList.add("bg-green-100", "text-green-900");
        icon.className = "w-10 h-10 rounded-full bg-[#58CC02] text-white flex items-center justify-center text-xl font-bold shrink-0";
        icon.textContent = "✓";
        title.textContent = "മികച്ചത്! 🎉";
        contBtn.className = "btn-3d w-full py-3.5 rounded-2xl font-extrabold text-base text-white bg-[#58CC02] border-b-4 border-[#46A302]";
      } else {
        drawer.classList.add("bg-red-100", "text-red-900");
        icon.className = "w-10 h-10 rounded-full bg-red-500 text-white flex items-center justify-center text-xl font-bold shrink-0";
        icon.textContent = "✕";
        title.textContent = "ശരിയല്ല";
        contBtn.className = "btn-3d w-full py-3.5 rounded-2xl font-extrabold text-base text-white bg-red-500 border-b-4 border-red-700";
      }
      detail.textContent = detailText;
    }

    document.getElementById("continue-lesson-btn").addEventListener("click", () => {
      playTone("tap");
      if (activeSession.hearts === 0) return;

      if (activeSession.currentIndex + 1 < activeSession.questions.length) {
        activeSession.currentIndex += 1;
        renderCurrentQuestion();
      } else {
        finishSession();
      }
    });

    function finishSession() {
      document.getElementById("lesson-modal").classList.add("hidden");
      document.getElementById("feedback-drawer").classList.add("hidden");
      document.getElementById("lesson-progress-bar").style.width = "100%";
      playTone("complete");

      let earnedXp = 15;
      let title = "പാഠം പൂർത്തിയായി!";
      let subtitle = "മികച്ച പ്രകടനം! അടുത്ത പാഠം അൺലോക്ക് ആയിരിക്കുന്നു.";
      let emoji = "🎉";

      if (activeSession.mode === "lesson") {
        if (!userState.completedLessons.includes(activeSession.lessonId)) {
          userState.completedLessons.push(activeSession.lessonId);
        }
        userState.xp += earnedXp;
      } else if (activeSession.mode === "placement") {
        const sc = activeSession.score;
        if (sc >= 7) {
          earnedXp = 100;
          unlockUpToUnit(3); // Unlocks Unit 4 (index 3)
          title = "ഗംഭീരം! യൂണിറ്റ് 4 അൺലോക്ക് ആയി!";
          subtitle = `8-ൽ ${sc} ശരിയുത്തരം! നിങ്ങൾ നേരിട്ട് യൂണിറ്റ് 4-ലേക്ക് കടന്നിരിക്കുന്നു.`;
          emoji = "🏆";
        } else if (sc >= 4) {
          earnedXp = 50;
          unlockUpToUnit(2); // Unlocks Unit 3 (index 2)
          title = "മികച്ചത്! യൂണിറ്റ് 3 അൺലോക്ക് ആയി!";
          subtitle = `8-ൽ ${sc} ശരിയുത്തരം! ആദ്യ രണ്ട് യൂണിറ്റുകൾ പൂർത്തിയായതായി രേഖപ്പെടുത്തി.`;
          emoji = "🚀";
        } else {
          earnedXp = 10;
          title = "നമുക്ക് ആദ്യം മുതൽ തുടങ്ങാം!";
          subtitle = `8-ൽ ${sc} ശരിയുത്തരം. യൂണിറ്റ് 1 മുതൽ അടിസ്ഥാന കാര്യങ്ങൾ എളുപ്പത്തിൽ പഠിക്കാം.`;
          emoji = "🌱";
        }
        userState.xp += earnedXp;
      } else if (activeSession.mode === "jump") {
        if (activeSession.score >= 4) {
          earnedXp = 40;
          unlockUpToUnit(activeSession.targetUnitIndex);
          title = `യൂണിറ്റ് ${activeSession.targetUnitIndex + 1} അൺലോക്ക് ആയി!`;
          subtitle = "പ്രവേശന പരീക്ഷ നിങ്ങൾ വിജയിച്ചിരിക്കുന്നു!";
          emoji = "🚀";
          userState.xp += earnedXp;
        } else {
          earnedXp = 5;
          title = "കുറച്ചുകൂടി പരിശീലിക്കാം!";
          subtitle = "ഈ യൂണിറ്റിലേക്ക് കടക്കാൻ 5-ൽ 4 ശരിയുത്തരം ആവശ്യമാണ്.";
          emoji = "💪";
          userState.xp += earnedXp;
        }
      }

      saveState();
      renderLearningPath();

      document.getElementById("complete-emoji").textContent = emoji;
      document.getElementById("complete-title").textContent = title;
      document.getElementById("complete-subtitle").textContent = subtitle;
      document.getElementById("complete-xp").textContent = `+${earnedXp} ⭐`;
      document.getElementById("complete-streak").textContent = `${userState.streak} 🔥`;
      document.getElementById("complete-modal").classList.remove("hidden");
      launchConfetti();
    }

    function unlockUpToUnit(targetUnitIndex) {
      for (let i = 0; i < targetUnitIndex; i++) {
        UNITS[i].lessons.forEach(l => {
          if (!userState.completedLessons.includes(l.id)) {
            userState.completedLessons.push(l.id);
          }
        });
      }
    }

    document.getElementById("complete-done-btn").addEventListener("click", () => {
      playTone("tap");
      document.getElementById("complete-modal").classList.add("hidden");
    });

    // Out of hearts modal actions
    document.getElementById("modal-refill-btn").addEventListener("click", () => {
      playTone("correct");
      userState.hearts = 5;
      activeSession.hearts = 5;
      saveState();
      document.getElementById("lesson-hearts-count").textContent = 5;
      document.getElementById("out-of-hearts-modal").classList.add("hidden");
    });

    document.getElementById("modal-quit-btn").addEventListener("click", () => {
      document.getElementById("out-of-hearts-modal").classList.add("hidden");
      closeLessonModal();
    });

    // ================= NAVIGATION & PROFILE ACTIONS =================
    function switchTab(tabName) {
      playTone("tap");
      ["path", "alphabet", "leaderboard", "profile"].forEach(t => {
        document.getElementById(`tab-${t}`).classList.add("hidden");
      });
      document.getElementById(`tab-${tabName}`).classList.remove("hidden");

      document.querySelectorAll(".nav-btn").forEach(btn => {
        if (btn.dataset.tab === tabName) {
          btn.className = "nav-btn flex flex-col items-center py-1 px-3 rounded-xl text-[#58CC02] bg-green-50 border border-green-200";
        } else {
          btn.className = "nav-btn flex flex-col items-center py-1 px-3 rounded-xl text-gray-500 hover:bg-gray-50";
        }
      });

      if (tabName === "leaderboard") loadLeaderboard();
      if (tabName === "profile") updateTopAndProfileUI();
    }

    document.querySelectorAll(".nav-btn").forEach(btn => {
      btn.addEventListener("click", () => switchTab(btn.dataset.tab));
    });

    function updateTopAndProfileUI() {
      document.getElementById("stat-streak").textContent = userState.streak;
      document.getElementById("stat-xp").textContent = userState.xp;
      document.getElementById("stat-hearts").textContent = userState.hearts;

      document.getElementById("profile-avatar").textContent = userState.avatar;
      document.getElementById("profile-name").textContent = userState.name || "പഠിതാവ്";
      document.getElementById("profile-uid").textContent = userState.uid ? `Cloud ID: ${userState.uid.slice(0, 8)}...` : "Offline Mode";
      document.getElementById("prof-streak").textContent = userState.streak;
      document.getElementById("prof-xp").textContent = userState.xp;
      document.getElementById("prof-lessons").textContent = `${userState.completedLessons.length}/${getAllLessonIds().length}`;
      document.getElementById("sound-toggle").checked = userState.soundEnabled;
    }

    document.getElementById("sound-toggle").addEventListener("change", (e) => {
      userState.soundEnabled = e.target.checked;
      saveState();
    });

    document.getElementById("edit-name-btn").addEventListener("click", () => {
      const newName = prompt("പുതിയ പേര് നൽകുക:", userState.name);
      if (newName && newName.trim()) {
        userState.name = newName.trim();
        saveState();
      }
    });

    document.getElementById("retake-placement-btn").addEventListener("click", () => {
      playTone("tap");
      startPlacementTest();
    });

    document.getElementById("refill-hearts-btn").addEventListener("click", () => {
      playTone("correct");
      userState.hearts = 5;
      saveState();
      alert("❤️ 5 ഹാർട്ടുകൾ നിറച്ചിരിക്കുന്നു!");
    });

    document.getElementById("reset-progress-btn").addEventListener("click", () => {
      if (confirm("നിങ്ങളുടെ എല്ലാ XP-യും പൂർത്തിയാക്കിയ പാഠങ്ങളും മായ്ച്ച് ആദ്യം മുതൽ തുടങ്ങണോ?")) {
        userState.xp = 0;
        userState.completedLessons = [];
        userState.hearts = 5;
        saveState();
        renderLearningPath();
        switchTab("path");
      }
    });

    // Hardware / Gesture Back Button Handler
    window.addEventListener("popstate", () => {
      const lessonModal = document.getElementById("lesson-modal");
      if (!lessonModal.classList.contains("hidden")) {
        closeLessonModal();
      }
    });

    // ================= CONFETTI ANIMATION =================
    function launchConfetti() {
      const canvas = document.getElementById("confetti-canvas");
      const ctx = canvas.getContext("2d");
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      const colors = ["#58CC02", "#1CB0F6", "#FFC800", "#FF4B4B", "#CE82FF"];
      const pieces = Array.from({ length: 70 }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height - canvas.height,
        r: Math.random() * 6 + 4,
        c: colors[Math.floor(Math.random() * colors.length)],
        vy: Math.random() * 3 + 2,
        vx: Math.random() * 2 - 1
      }));

      let frame = 0;
      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        pieces.forEach(p => {
          ctx.fillStyle = p.c;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
          p.y += p.vy;
          p.x += p.vx;
        });
        frame++;
        if (frame < 130) requestAnimationFrame(draw);
        else ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
      draw();
    }

    // ================= APP BOOTSTRAP =================
    async function initApp() {
      const hasProfile = loadLocalState();
      renderAlphabetGrid();
      renderLearningPath();
      updateTopAndProfileUI();

      if (!hasProfile || !userState.name) {
        document.getElementById("onboarding-screen").classList.remove("hidden");
      } else {
        await ensureFirebaseAuth();
        saveState();
      }
    }

    initApp();
  </script>
</body>
