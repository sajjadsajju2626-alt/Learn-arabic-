<!DOCTYPE html>
<html lang="ml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>മലയാളത്തിലൂടെ അറബി പഠിക്കാം | Learn Arabic</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@600;700;800&family=Noto+Sans+Malayalam:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      font-family: 'Noto Sans Malayalam', sans-serif;
      background-color: #F7F7F7;
      color: #3C3C3C;
      overflow-x: hidden;
      user-select: none;
    }
    .font-arabic {
      font-family: 'Amiri', 'Cairo', serif;
      direction: rtl;
      line-height: 1.8;
    }
    .font-arabic-ui {
      font-family: 'Cairo', 'Amiri', sans-serif;
      direction: rtl;
    }
    .btn-3d {
      transition: all 0.1s ease;
    }
    .btn-3d:active:not(:disabled) {
      transform: translateY(3px);
      border-bottom-width: 1px !important;
    }
    @keyframes bounceSlow {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }
    .animate-bounce-slow {
      animation: bounceSlow 1.6s infinite ease-in-out;
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-6px); }
      40%, 80% { transform: translateX(6px); }
    }
    .animate-shake {
      animation: shake 0.4s ease-in-out;
    }
    @keyframes popIn {
      0% { transform: scale(0.85); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop {
      animation: popIn 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }
    /* Custom scrollbar hide */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen flex justify-center">

  <!-- Main Mobile Container -->
  <div id="app" class="w-full max-w-md bg-white min-h-screen shadow-xl relative flex flex-col">

    <!-- ================= ONBOARDING SCREEN ================= -->
    <div id="onboarding-screen" class="hidden fixed inset-0 z-50 bg-white flex flex-col justify-between p-6 max-w-md mx-auto overflow-y-auto">
      <div class="text-center mt-4">
        <div class="w-20 h-20 bg-[#58CC02] rounded-3xl mx-auto flex items-center justify-center text-4xl shadow-md border-b-4 border-[#46A302] mb-4">
          🕌
        </div>
        <h1 class="text-2xl font-extrabold text-gray-800">മലയാളത്തിലൂടെ അറബി പഠിക്കാം</h1>
        <p class="text-sm text-gray-500 mt-1">കളികളിലൂടെയും ക്വിസുകളിലൂടെയും എളുപ്പത്തിൽ അറബി ഭാഷ സ്വായത്തമാക്കൂ!</p>
      </div>

      <div class="space-y-5 my-6">
        <!-- Avatar Picker -->
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase mb-2 text-center">നിങ്ങളുടെ അവതാർ തിരഞ്ഞെടുക്കുക</label>
          <div id="avatar-selector" class="flex justify-center gap-3">
            <button type="button" data-avatar="🧕" class="avatar-opt w-12 h-12 rounded-2xl text-2xl border-2 border-[#58CC02] bg-green-50 flex items-center justify-center transition">🧕</button>
            <button type="button" data-avatar="👳‍♂️" class="avatar-opt w-12 h-12 rounded-2xl text-2xl border-2 border-gray-200 bg-white flex items-center justify-center transition">👳‍♂️</button>
            <button type="button" data-avatar="🧑‍🎓" class="avatar-opt w-12 h-12 rounded-2xl text-2xl border-2 border-gray-200 bg-white flex items-center justify-center transition">🧑‍🎓</button>
            <button type="button" data-avatar="🌟" class="avatar-opt w-12 h-12 rounded-2xl text-2xl border-2 border-gray-200 bg-white flex items-center justify-center transition">🌟</button>
            <button type="button" data-avatar="🦁" class="avatar-opt w-12 h-12 rounded-2xl text-2xl border-2 border-gray-200 bg-white flex items-center justify-center transition">🦁</button>
          </div>
        </div>

        <!-- Name Input -->
        <div>
          <label class="block text-sm font-bold text-gray-700 mb-1.5">നിങ്ങളുടെ പേര് നൽകുക</label>
          <input id="onboarding-name" type="text" maxlength="25" placeholder="ഉദാ: അഹമ്മദ്, ഫാത്തിമ..."
            class="w-full px-4 py-3.5 rounded-2xl border-2 border-gray-200 focus:border-[#1CB0F6] focus:outline-none text-base font-semibold bg-gray-50" />
          <p id="name-error" class="text-xs text-red-500 font-semibold mt-1 hidden">ദയവായി നിങ്ങളുടെ പേര് നൽകുക!</p>
        </div>

        <!-- Level Selection -->
        <div class="pt-2 space-y-3">
          <p class="text-sm font-bold text-gray-700">എവിടെ നിന്ന് തുടങ്ങണം?</p>
          
          <button id="start-basics-btn" class="btn-3d w-full text-left p-4 rounded-2xl border-2 border-b-4 border-[#58CC02] bg-green-50/70 hover:bg-green-50 flex items-center gap-3.5">
            <span class="text-3xl">🌱</span>
            <div>
              <div class="font-extrabold text-[#46A302] text-base">ആദ്യം മുതൽ തുടങ്ങാം</div>
              <div class="text-xs text-gray-600 mt-0.5">അറബി അക്ഷരങ്ങൾ (അലിഫ്, ബാ, താ) മുതൽ പഠിച്ചു തുടങ്ങാം</div>
            </div>
          </button>

          <button id="start-placement-btn" class="btn-3d w-full text-left p-4 rounded-2xl border-2 border-b-4 border-[#1CB0F6] bg-sky-50/70 hover:bg-sky-50 flex items-center gap-3.5">
            <span class="text-3xl">🚀</span>
            <div>
              <div class="font-extrabold text-[#1899D6] text-base">എനിക്ക് അറബി കുറച്ചൊക്കെ അറിയാം</div>
              <div class="text-xs text-gray-600 mt-0.5">ചെറിയൊരു ടെസ്റ്റ് എഴുതി നേരിട്ട് ഉയർന്ന ലെവലിലേക്ക് കടക്കാം</div>
            </div>
          </button>
        </div>
      </div>

      <p class="text-center text-[11px] text-gray-400">പഠന പുരോഗതി സ്വയമേവ സേവ് ചെയ്യപ്പെടും</p>
    </div>

    <!-- ================= TOP STATS BAR ================= -->
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-gray-200 px-4 py-2.5 flex items-center justify-between">
      <div class="flex items-center gap-1.5">
        <span class="text-xl">🇸🇦</span>
        <span id="sync-badge" title="Cloud Sync Status" class="w-2 h-2 rounded-full bg-green-500 inline-block"></span>
      </div>

      <div class="flex items-center gap-4 font-extrabold text-sm">
        <!-- Streak -->
        <div class="flex items-center gap-1 text-orange-500" title="Daily Streak">
          <span class="text-lg">🔥</span>
          <span id="stat-streak">1</span>
        </div>
        <!-- XP -->
        <div class="flex items-center gap-1 text-amber-500" title="Total XP">
          <span class="text-lg">⭐</span>
          <span id="stat-xp">0</span>
        </div>
        <!-- Hearts -->
        <div class="flex items-center gap-1 text-rose-500" title="Hearts">
          <span class="text-lg">❤️</span>
          <span id="stat-hearts">5</span>
        </div>
      </div>
    </header>

    <!-- ================= MAIN TAB VIEWS ================= -->
    <main class="flex-1 pb-24 overflow-y-auto">

      <!-- TAB 1: LEARNING PATH -->
      <section id="tab-path" class="p-4 space-y-8">
        <!-- Units & Nodes rendered dynamically -->
        <div id="units-container" class="space-y-8"></div>
      </section>

      <!-- TAB 2: ALPHABET & HARAKAT -->
      <section id="tab-alphabet" class="hidden p-4">
        <div class="text-center mb-4">
          <h2 class="text-xl font-extrabold text-gray-800">അറബി അക്ഷരമാലയും ഹറകത്തുകളും</h2>
          <p class="text-xs text-gray-500 mt-0.5">ഉച്ചാരണം കേൾക്കാൻ ഓരോ അക്ഷരത്തിലും തൊടുക 🔊</p>
        </div>

        <!-- Harakat Vowel Switcher -->
        <div class="flex gap-1.5 overflow-x-auto no-scrollbar pb-3 mb-3 sticky top-0 bg-white z-10 pt-1">
          <button data-vowel="base" class="vowel-btn flex-1 min-w-[68px] py-2 px-2 rounded-xl text-xs font-extrabold border-2 border-b-4 border-[#58CC02] bg-green-50 text-[#46A302]">
            അടിസ്ഥാനം<br><span class="font-arabic text-base">ا ب ت</span>
          </button>
          <button data-vowel="fatha" class="vowel-btn flex-1 min-w-[68px] py-2 px-2 rounded-xl text-xs font-extrabold border-2 border-b-4 border-gray-200 bg-white text-gray-600">
            ഫത്ഹ് ( َ )<br><span class="font-arabic text-base">بَ تَ</span>
          </button>
          <button data-vowel="kasra" class="vowel-btn flex-1 min-w-[68px] py-2 px-2 rounded-xl text-xs font-extrabold border-2 border-b-4 border-gray-200 bg-white text-gray-600">
            കസ്റ് ( ِ )<br><span class="font-arabic text-base">بِ تِ</span>
          </button>
          <button data-vowel="damma" class="vowel-btn flex-1 min-w-[68px] py-2 px-2 rounded-xl text-xs font-extrabold border-2 border-b-4 border-gray-200 bg-white text-gray-600">
            ളമ്മ് ( ُ )<br><span class="font-arabic text-base">بُ تُ</span>
          </button>
          <button data-vowel="tanween" class="vowel-btn flex-1 min-w-[68px] py-2 px-2 rounded-xl text-xs font-extrabold border-2 border-b-4 border-gray-200 bg-white text-gray-600">
            തൻവീൻ ( ً )<br><span class="font-arabic text-base">بًا تًا</span>
          </button>
        </div>

        <!-- 28 Letters Grid (RTL order for Arabic) -->
        <div id="alphabet-grid" dir="rtl" class="grid grid-cols-4 gap-2.5"></div>
      </section>

      <!-- TAB 3: LEADERBOARD -->
      <section id="tab-leaderboard" class="hidden p-4">
        <div class="bg-gradient-to-r from-amber-400 to-yellow-500 rounded-2xl p-4 text-white mb-4 shadow-sm flex items-center justify-between">
          <div>
            <h2 class="text-lg font-extrabold">ലീഡർബോർഡ് 🏆</h2>
            <p class="text-xs text-amber-50">ഏറ്റവും കൂടുതൽ XP നേടിയ പഠിതാക്കൾ</p>
          </div>
          <button id="refresh-lb-btn" class="bg-white/20 hover:bg-white/30 px-3 py-1.5 rounded-xl text-xs font-bold">
            🔄 പുതുക്കുക
          </button>
        </div>

        <div id="leaderboard-list" class="space-y-2.5">
          <div class="text-center py-10 text-gray-400 text-sm">ലോഡ് ചെയ്യുന്നു...</div>
        </div>
      </section>

      <!-- TAB 4: PROFILE -->
      <section id="tab-profile" class="hidden p-4 space-y-5">
        <div class="bg-white border-2 border-gray-200 rounded-3xl p-5 text-center relative">
          <div id="profile-avatar" class="w-20 h-20 rounded-full bg-sky-100 border-4 border-[#1CB0F6] mx-auto flex items-center justify-center text-4xl mb-3">
            🧕
          </div>
          <div class="flex items-center justify-center gap-2">
            <h2 id="profile-name" class="text-xl font-extrabold text-gray-800">പഠിതാവ്</h2>
            <button id="edit-name-btn" class="text-xs bg-gray-100 hover:bg-gray-200 px-2.5 py-1 rounded-lg font-bold text-gray-600">✏️ മാറ്റുക</button>
          </div>
          <p id="profile-uid" class="text-[11px] text-gray-400 mt-1">ID: ---</p>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-3 gap-2.5">
          <div class="border-2 border-gray-200 rounded-2xl p-3 text-center">
            <div class="text-2xl">🔥</div>
            <div id="prof-streak" class="font-extrabold text-lg text-gray-800 mt-0.5">1</div>
            <div class="text-[11px] text-gray-500 font-semibold">ദിവസം (Streak)</div>
          </div>
          <div class="border-2 border-gray-200 rounded-2xl p-3 text-center">
            <div class="text-2xl">⭐</div>
            <div id="prof-xp" class="font-extrabold text-lg text-gray-800 mt-0.5">0</div>
            <div class="text-[11px] text-gray-500 font-semibold">ആകെ XP</div>
          </div>
          <div class="border-2 border-gray-200 rounded-2xl p-3 text-center">
            <div class="text-2xl">🎯</div>
            <div id="prof-lessons" class="font-extrabold text-lg text-gray-800 mt-0.5">0/12</div>
            <div class="text-[11px] text-gray-500 font-semibold">പാഠങ്ങൾ</div>
          </div>
        </div>

        <!-- Settings & Actions -->
        <div class="border-2 border-gray-200 rounded-2xl divide-y divide-gray-100 overflow-hidden">
          <div class="p-4 flex items-center justify-between">
            <div>
              <div class="font-bold text-sm text-gray-800">ശബ്ദ ഇഫക്റ്റുകൾ (Sound Effects)</div>
              <div class="text-xs text-gray-500">ഉത്തരങ്ങളുടെയും ഉച്ചാരണത്തിന്റെയും ശബ്ദം</div>
            </div>
            <input id="sound-toggle" type="checkbox" checked class="w-5 h-5 accent-[#58CC02] rounded cursor-pointer" />
          </div>

          <button id="retake-placement-btn" class="w-full p-4 text-left flex items-center justify-between hover:bg-gray-50">
            <div>
              <div class="font-bold text-sm text-[#1899D6]">നിലവാര നിർണ്ണയ പരീക്ഷ (Placement Test)</div>
              <div class="text-xs text-gray-500">ടെസ്റ്റ് എഴുതി ഉയർന്ന യൂണിറ്റുകളിലേക്ക് നേരിട്ട് കടക്കുക</div>
            </div>
            <span class="text-lg">🚀</span>
          </button>

          <button id="refill-hearts-btn" class="w-full p-4 text-left flex items-center justify-between hover:bg-gray-50">
            <div>
              <div class="font-bold text-sm text-rose-500">ഹാർട്ടുകൾ നിറയ്ക്കുക (Refill Hearts)</div>
              <div class="text-xs text-gray-500">5 ഹാർട്ടുകൾ സൗജന്യമായി തിരികെ നേടുക</div>
            </div>
            <span class="text-lg">❤️</span>
          </button>

          <button id="reset-progress-btn" class="w-full p-4 text-left flex items-center justify-between hover:bg-red-50">
            <div>
              <div class="font-bold text-sm text-red-600">പ്രോഗ്രസ് റീസെറ്റ് ചെയ്യുക (Reset)</div>
              <div class="text-xs text-gray-500">എല്ലാ പാഠങ്ങളും ആദ്യം മുതൽ തുടങ്ങുക</div>
            </div>
            <span class="text-lg">⚠️</span>
          </button>
        </div>
      </section>

    </main>

    <!-- ================= BOTTOM NAVIGATION BAR ================= -->
    <nav class="fixed bottom-0 z-30 w-full max-w-md bg-white border-t-2 border-gray-200 px-2 py-1.5 flex justify-around items-center">
      <button data-tab="path" class="nav-btn flex flex-col items-center py-1 px-3 rounded-xl text-[#58CC02] bg-green-50 border border-green-200">
        <span class="text-xl">🏠</span>
        <span class="text-[11px] font-extrabold mt-0.5">പഠനം</span>
      </button>
      <button data-tab="alphabet" class="nav-btn flex flex-col items-center py-1 px-3 rounded-xl text-gray-500 hover:bg-gray-50">
        <span class="text-xl font-arabic font-bold leading-6">أ ب</span>
        <span class="text-[11px] font-bold mt-0.5">അക്ഷരങ്ങൾ</span>
      </button>
      <button data-tab="leaderboard" class="nav-btn flex flex-col items-center py-1 px-3 rounded-xl text-gray-500 hover:bg-gray-50">
        <span class="text-xl">🏆</span>
        <span class="text-[11px] font-bold mt-0.5">റാങ്ക്</span>
      </button>
      <button data-tab="profile" class="nav-btn flex flex-col items-center py-1 px-3 rounded-xl text-gray-500 hover:bg-gray-50">
        <span class="text-xl">👤</span>
        <span class="text-[11px] font-bold mt-0.5">പ്രൊഫൈൽ</span>
      </button>
    </nav>

    <!-- ================= FULL-SCREEN LESSON / TEST MODAL ================= -->
    <div id="lesson-modal" class="hidden fixed inset-0 z-50 bg-white flex flex-col max-w-md mx-auto">
      <!-- Top Bar -->
      <div class="px-4 py-3 flex items-center gap-3 border-b border-gray-100">
        <button id="close-lesson-btn" class="text-gray-400 hover:text-gray-600 text-2xl font-bold leading-none p-1">✕</button>
        <div class="flex-1 bg-gray-200 h-3.5 rounded-full overflow-hidden">
          <div id="lesson-progress-bar" class="bg-[#58CC02] h-full w-0 transition-all duration-300 rounded-full"></div>
        </div>
        <div id="lesson-hearts-display" class="flex items-center gap-1 font-extrabold text-rose-500 text-sm">
          <span>❤️</span><span id="lesson-hearts-count">5</span>
        </div>
      </div>

      <!-- Mode Badge (e.g., Placement Test / Unit Jump) -->
      <div id="lesson-mode-banner" class="hidden bg-sky-50 text-[#1899D6] text-xs font-extrabold text-center py-1.5 border-b border-sky-100">
        നിലവാര നിർണ്ണയ പരീക്ഷ (Placement Test)
      </div>

      <!-- Question Body -->
      <div id="question-container" class="flex-1 p-5 overflow-y-auto flex flex-col justify-between">
        <!-- Injected dynamically -->
      </div>

      <!-- Bottom Check Button Area -->
      <div id="check-area" class="p-4 border-t border-gray-200 bg-white">
        <button id="check-answer-btn" disabled class="btn-3d w-full py-3.5 rounded-2xl font-extrabold text-base uppercase tracking-wide bg-gray-200 text-gray-400 border-b-4 border-gray-300 cursor-not-allowed">
          പരിശോധിക്കുക
        </button>
      </div>

      <!-- Slide-Up Instant Feedback Drawer -->
      <div id="feedback-drawer" class="hidden fixed bottom-0 left-0 right-0 max-w-md mx-auto p-5 z-50 rounded-t-3xl shadow-2xl animate-pop">
        <div class="flex items-start gap-3 mb-4">
          <div id="feedback-icon" class="w-10 h-10 rounded-full flex items-center justify-center text-xl font-bold shrink-0"></div>
          <div>
            <h3 id="feedback-title" class="font-extrabold text-lg"></h3>
            <p id="feedback-detail" class="text-sm font-semibold mt-0.5"></p>
          </div>
        </div>
        <button id="continue-lesson-btn" class="btn-3d w-full py-3.5 rounded-2xl font-extrabold text-base text-white border-b-4">
          തുടരുക
        </button>
      </div>
    </div>

    <!-- ================= LESSON / TEST COMPLETE SCREEN ================= -->
    <div id="complete-modal" class="hidden fixed inset-0 z-50 bg-white flex flex-col items-center justify-between p-6 max-w-md mx-auto text-center">
      <canvas id="confetti-canvas" class="fixed inset-0 pointer-events-none z-10"></canvas>
      
      <div class="mt-10 z-20 animate-pop">
        <div id="complete-emoji" class="text-7xl mb-4">🎉</div>
        <h2 id="complete-title" class="text-2xl font-extrabold text-[#58CC02]">പാഠം പൂർത്തിയായി!</h2>
        <p id="complete-subtitle" class="text-sm text-gray-600 mt-2 max-w-xs mx-auto">മികച്ച പ്രകടനം! നിങ്ങൾ അടുത്ത ഘട്ടത്തിലേക്ക് കടന്നിരിക്കുന്നു.</p>

        <div class="flex justify-center gap-4 mt-8">
          <div class="bg-amber-50 border-2 border-amber-300 rounded-2xl px-6 py-3">
