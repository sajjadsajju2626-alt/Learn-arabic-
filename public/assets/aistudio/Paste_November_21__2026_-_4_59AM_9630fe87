      if (!userState.soundEnabled) return;
      try {
        if (audioCtx.state === "suspended") audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);

        const now = audioCtx.currentTime;
        if (type === "correct") {
          osc.type = "sine";
          osc.frequency.setValueAtTime(523.25, now); // C5
          osc.frequency.setValueAtTime(659.25, now + 0.1); // E5
          gain.gain.setValueAtTime(0.2, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
          osc.start(now);
          osc.stop(now + 0.3);
        } else if (type === "wrong") {
          osc.type = "sawtooth";
          osc.frequency.setValueAtTime(180, now);
          osc.frequency.linearRampToValueAtTime(130, now + 0.25);
          gain.gain.setValueAtTime(0.2, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.28);
          osc.start(now);
          osc.stop(now + 0.28);
        } else if (type === "complete") {
          osc.type = "triangle";
          [523.25, 659.25, 783.99, 1046.5].forEach((freq, i) => {
            osc.frequency.setValueAtTime(freq, now + i * 0.1);
          });
          gain.gain.setValueAtTime(0.22, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.55);
          osc.start(now);
          osc.stop(now + 0.55);
        } else if (type === "tap") {
          osc.type = "sine";
          osc.frequency.setValueAtTime(420, now);
          gain.gain.setValueAtTime(0.08, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.06);
          osc.start(now);
          osc.stop(now + 0.06);
        }
      } catch (e) {}
    }

    function speakArabic(text, rate = 0.9) {
      if (!userState.soundEnabled || !text) return;
      try {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(text);
        utter.lang = "ar-SA";
        utter.rate = rate;
        const voices = window.speechSynthesis.getVoices();
        const arVoice = voices.find(v => v.lang.startsWith("ar"));
        if (arVoice) utter.voice = arVoice;
        window.speechSynthesis.speak(utter);
      } catch (e) {
        console.warn("TTS fallback:", e);
      }
    }
    if (window.speechSynthesis) {
      window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
    }

    // ================= PERSISTENCE & FIREBASE SYNC =================
    function loadLocalState() {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        userState = { ...userState, ...JSON.parse(saved) };
        checkStreak();
        return true;
      }
      return false;
    }

    function checkStreak() {
      const today = new Date().toDateString();
      if (userState.lastActiveDate !== today) {
        const yesterday = new Date(Date.now() - 86400000).toDateString();
        if (userState.lastActiveDate === yesterday) {
          userState.streak += 1;
        } else {
          userState.streak = 1;
        }
        userState.hearts = 5;
        userState.lastActiveDate = today;
        saveState();
      }
    }

    async function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(userState));
      updateTopAndProfileUI();

      if (db && userState.uid) {
        const badge = document.getElementById("sync-badge");
        badge.className = "w-2 h-2 rounded-full bg-amber-400 inline-block animate-pulse";
        try {
          await setDoc(doc(db, "users", userState.uid), {
            name: userState.name,
            avatar: userState.avatar,
            xp: userState.xp,
            streak: userState.streak,
            hearts: userState.hearts,
            completedLessons: userState.completedLessons,
            lastActiveDate: userState.lastActiveDate,
            updatedAt: new Date().toISOString()
          }, { merge: true });
          badge.className = "w-2 h-2 rounded-full bg-green-500 inline-block";
        } catch (err) {
          console.warn("Cloud sync delayed:", err);
          badge.className = "w-2 h-2 rounded-full bg-gray-400 inline-block";
        }
      }
    }

    async function ensureFirebaseAuth() {
      if (!auth) return;
      return new Promise((resolve) => {
        onAuthStateChanged(auth, async (user) => {
          if (user) {
            userState.uid = user.uid;
            saveState();
            resolve(user);
          } else {
            try {
              const cred = await signInAnonymously(auth);
              userState.uid = cred.user.uid;
              saveState();
              resolve(cred.user);
            } catch (e) {
              console.warn("Anonymous auth failed offline:", e);
              resolve(null);
            }
          }
        });
      });
    }

