              </button>
            ` : `<span class="text-2xl">📖</span>`}
          </div>
        `;
        unitDiv.appendChild(header);

        // Winding Lesson Nodes
        const pathWrapper = document.createElement("div");
        pathWrapper.className = "flex flex-col items-center space-y-6 py-2 relative";

        const offsets = ["translate-x-0", "-translate-x-10", "translate-x-0", "translate-x-10"];

        unit.lessons.forEach((lesson, lIdx) => {
          const globalIdx = allIds.indexOf(lesson.id);
          const isCompleted = userState.completedLessons.includes(lesson.id);
          const isUnlocked = isCompleted || globalIdx === 0 || userState.completedLessons.includes(allIds[globalIdx - 1]);
          const isCurrent = isUnlocked && !isCompleted;

          const nodeWrapper = document.createElement("div");
          nodeWrapper.className = `relative flex flex-col items-center ${offsets[(globalIdx) % offsets.length]}`;

          // Bouncing START tooltip for current lesson
          if (isCurrent) {
            const tooltip = document.createElement("div");
            tooltip.className = "animate-bounce-slow mb-2 bg-white text-[#58CC02] font-extrabold text-xs px-3 py-1 rounded-xl border-2 border-gray-200 shadow-sm uppercase tracking-wider";
            tooltip.textContent = "തുടങ്ങുക";
            nodeWrapper.appendChild(tooltip);
