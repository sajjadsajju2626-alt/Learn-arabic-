    }

    function startUnitJumpTest(targetUnitIndex) {
      // Pick 5 questions from units prior to targetUnitIndex
      const pool = [];
      for (let i = 0; i < targetUnitIndex; i++) {
        UNITS[i].lessons.forEach(l => {
          l.questions.forEach(q => {
            if (q.type !== "pairs") pool.push(q);
          });
        });
      }
      const shuffled = pool.sort(() => 0.5 - Math.random()).slice(0, 5);
      activeSession = {
        mode: "jump",
        lessonId: null,
        targetUnitIndex,
        questions: JSON.parse(JSON.stringify(shuffled)),
        currentIndex: 0,
        score: 0,
        hearts: 3,
        selectedAnswer: null,
        wordBankSelected: [],
        pairsMatched: 0,
        selectedLeft: null,
        selectedRight: null,
        isAnswered: false,
        isCorrect: false
      };
      openLessonModal(`🚀 യൂണിറ്റ് ${targetUnitIndex + 1}-ലേക്കുള്ള പ്രവേശന ടെസ്റ്റ്`);
    }

