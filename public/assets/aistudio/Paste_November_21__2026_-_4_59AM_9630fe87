    function startLesson(lesson) {
      if (userState.hearts <= 0) {
        document.getElementById("out-of-hearts-modal").classList.remove("hidden");
        return;
      }
      activeSession = {
        mode: "lesson",
        lessonId: lesson.id,
        targetUnitIndex: null,
        questions: JSON.parse(JSON.stringify(lesson.questions)),
        currentIndex: 0,
        score: 0,
        hearts: userState.hearts,
        selectedAnswer: null,
        wordBankSelected: [],
        pairsMatched: 0,
        selectedLeft: null,
        selectedRight: null,
        isAnswered: false,
        isCorrect: false
      };
      openLessonModal(null);
    }

    function startPlacementTest() {
      activeSession = {
        mode: "placement",
        lessonId: null,
        targetUnitIndex: null,
        questions: JSON.parse(JSON.stringify(PLACEMENT_QUESTIONS)),
        currentIndex: 0,
        score: 0,
        hearts: 5,
        selectedAnswer: null,
        wordBankSelected: [],
        pairsMatched: 0,
        selectedLeft: null,
        selectedRight: null,
        isAnswered: false,
